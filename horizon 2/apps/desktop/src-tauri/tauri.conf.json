{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Horizon 2",
  "version": "0.0.1",
  "identifier": "org.horizoninterstellar.horizon2",
  "build": {
    "frontendDist": "../../web/build",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev --workspace @horizon/web -- --host 127.0.0.1 --port 5173 --strictPort",
    "beforeBuildCommand": "npm run build --workspace @horizon/web"
  },
  "app": {
    "windows": [
      {
        "title": "Horizon 2",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:3000"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
