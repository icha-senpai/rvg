{
  "name": "horizon-2",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": ["apps/web", "apps/desktop", "packages/generated/typescript"],
  "engines": { "node": ">=24 <25", "npm": ">=11" },
  "scripts": {
    "dev": "npm run dev --workspace @horizon/web -- --host 127.0.0.1 --port 5173 --strictPort",
    "check": "npm run check --workspace @horizon/web",
    "lint": "npm run lint --workspace @horizon/web",
    "format": "npm run format --workspace @horizon/web",
    "build": "npm run build --workspace @horizon/web",
    "bindings": "node tooling/generate-bindings.mjs",
    "spacetime": "node tooling/spacetime.mjs",
    "desktop:dev": "npm run dev --workspace @horizon/desktop --",
    "desktop:build": "npm run build --workspace @horizon/desktop --"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.22",
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.12.1"
  }
}
